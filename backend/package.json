{
  "name": "@vn-trading/backend",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "prisma generate && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src",
    "test": "vitest run",
    "prisma:generate": "prisma generate",
    "prisma:readiness": "tsx src/readiness.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.12.0",
    "express": "5.1.0",
    "zod": "3.24.2"
  },
  "devDependencies": {
    "@types/express": "5.0.1",
    "@types/supertest": "6.0.3",
    "prisma": "^6.12.0",
    "supertest": "7.1.3",
    "tsx": "4.19.3",
    "vitest": "5.0.0"
  }
}
