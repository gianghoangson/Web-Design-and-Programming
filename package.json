{
  "name": "vn-trading-platform",
  "private": true,
  "workspaces": [
    "frontend",
    "backend"
  ],
  "engines": {
    "node": ">=22.13.0 <23"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "npm run build --workspace frontend && npm run build --workspace backend",
    "typecheck": "npm run typecheck --workspace frontend && npm run typecheck --workspace backend",
    "lint": "eslint .",
    "format:check": "prettier --check .",
    "test": "npm run test --workspace backend && npm run test --workspace frontend",
    "db:generate": "npm run prisma:generate --workspace backend",
    "db:readiness": "npm run prisma:readiness --workspace backend"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "22.13.10",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "0.4.19",
    "prettier": "3.5.3",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.70.0"
  }
}
